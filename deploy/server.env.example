# ccks server environment template for Docker Compose.
# Copy this file to the server project root as `.env`, then replace every
# CHANGE_ME_* and YOUR_DOMAIN_OR_IP value before running `docker compose up --build -d`.

PORT=3000

MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=ccks
MYSQL_USER=ccks
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
CCKS_DATABASE_MODE=mysql
DATABASE_URL=mysql://ccks:CHANGE_ME_MYSQL_PASSWORD@mysql:3306/ccks
CCKS_PROJECT_ROOT=/data/ccks-projects

# Portal auth. Keep LOCAL_AUTH_BYPASS=false in production.
NEXT_PUBLIC_ZR_PORTAL_URL=https://zrg.zrbyhelp.com
NEXT_PUBLIC_ZR_SERVICE_SLUG=ccks
ZR_CLIENT_ID=CHANGE_ME_COPY_FROM_LOCAL_ENV
ZR_CLIENT_SECRET=CHANGE_ME_COPY_FROM_LOCAL_ENV
ZR_CALLBACK_URL=https://YOUR_DOMAIN_OR_IP/api/auth/callback
LOCAL_AUTH_BYPASS=false

# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_OPENSSL_RAND_HEX_32
# Optional. Leave blank to reuse SESSION_SECRET through application fallback.
CCKS_SESSION_SECRET=
CCKS_API_TOKEN_SECRET=

CCKS_ADMIN_ACCOUNTS=q19946502
CCKS_ADMIN_EMAILS=

# GitHub OAuth. The callback must match the GitHub OAuth App settings.
GITHUB_CLIENT_ID=CHANGE_ME_COPY_FROM_LOCAL_ENV
GITHUB_CLIENT_SECRET=CHANGE_ME_COPY_FROM_LOCAL_ENV
GITHUB_CALLBACK_URL=https://YOUR_DOMAIN_OR_IP/api/github/callback

# AI provider API key encryption. Keep stable after deployment or saved keys cannot be decrypted.
# Use the local value if you need to preserve existing encrypted provider keys, or generate a new
# 64-character hex value with: openssl rand -hex 32
AI_PROVIDER_SECRET_KEY=CHANGE_ME_COPY_FROM_LOCAL_ENV_OR_OPENSSL_RAND_HEX_32
