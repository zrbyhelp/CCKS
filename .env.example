PORT=3000

MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=ccks_root_password
MYSQL_DATABASE=ccks
MYSQL_USER=ccks
MYSQL_PASSWORD=ccks_password
CCKS_DATABASE_MODE=mysql
DATABASE_URL=mysql://ccks:ccks_password@mysql:3306/ccks
# 本地无 Docker/MySQL 调试时运行 npm run dev:local，默认使用 .ccks-local/dev.db。
# CCKS_SQLITE_DATABASE_URL=file:./.ccks-local/dev.db
CCKS_PROJECT_ROOT=.ccks-projects

# 统一门户对接。未配置时登录会返回配置错误，公告为空，投诉建议弹窗显示配置提示。
NEXT_PUBLIC_ZR_PORTAL_URL=
NEXT_PUBLIC_ZR_SERVICE_SLUG=ccks
ZR_CLIENT_ID=
ZR_CLIENT_SECRET=
ZR_CALLBACK_URL=
LOCAL_AUTH_BYPASS=false
SESSION_SECRET=change-me-to-a-long-random-string
CCKS_ADMIN_ACCOUNTS=
CCKS_ADMIN_EMAILS=

# GitHub OAuth。GitHub 登录数据只保存到浏览器缓存，不写入 MySQL。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# AI 供应商 API Key 加密密钥。建议使用 32 字节随机值的 base64 或 64 位 hex。
AI_PROVIDER_SECRET_KEY=

# AI 工具外部服务。未配置对应 key 时，相关工具会返回明确错误。
CCKS_DEFAULT_TIMEZONE=Asia/Shanghai
BRAVE_SEARCH_API_KEY=
JINA_API_KEY=
WIKIMEDIA_ACCESS_TOKEN=
WIKIMEDIA_USER_AGENT="ccks/1.0 (contact@example.com)"
MAPBOX_ACCESS_TOKEN=
CLOUDFLARE_TEMP_EMAIL_BASE_URL=
CLOUDFLARE_TEMP_EMAIL_CUSTOM_AUTH=
CLOUDFLARE_TEMP_EMAIL_ADMIN_AUTH=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
