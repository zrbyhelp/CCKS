generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Project {
  id            String   @id @default(cuid())
  userId        String
  name          String
  fileName      String
  localPath     String
  source        String   @default("local")
  repositoryUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, fileName])
  @@index([userId])
}

model AiProvider {
  id              String   @id @default(cuid())
  userId          String
  name            String
  providerType    String
  baseUrl         String
  apiKeyEncrypted String   @db.Text
  models          Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model SystemAiSetting {
  id              String   @id @default("global")
  providerType    String   @default("custom")
  baseUrl         String   @default("")
  apiKeyEncrypted String?  @db.Text
  models          Json
  model           String   @default("")
  reasoningEffort String   @default("auto")
  maxToolRounds   Int      @default(5)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UserApiToken {
  id           String    @id @default(cuid())
  userId       String    @unique
  tokenHash    String    @unique
  tokenPrefix  String
  tokenMasked  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastUsedAt   DateTime?

  @@index([tokenPrefix])
}

model RecipeVariableCategory {
  id            String           @id @default(cuid())
  userId        String
  nameZh        String
  nameEn        String
  icon          String           @default("boxes")
  descriptionZh String           @db.Text
  descriptionEn String           @db.Text
  tipZh         String           @db.Text
  tipEn         String           @db.Text
  changeLog     Json
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  variables     RecipeVariable[]

  @@unique([userId, nameZh])
  @@index([userId])
}

model RecipeVariable {
  id            String                 @id @default(cuid())
  userId        String
  categoryId    String
  variableName  String
  nameZh        String
  nameEn        String
  contentZh     String                 @db.Text
  contentEn     String                 @db.Text
  candidates    Json
  defaultValues Json
  multiple      Boolean                @default(false)
  changeLog     Json
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  category      RecipeVariableCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, variableName])
  @@index([categoryId])
  @@index([userId])
}
